# 复制本文件为 .env 后填写。LLM 三项留空时，Agent 对话功能会提示未配置，
# 但模板粘贴解析、手动记录、统计图表等功能不受影响，可正常使用。

# ---- LLM 接入（OpenAI 兼容接口）----
# 豆包（火山方舟）示例：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=你的推理接入点 ID
# DeepSeek 官方示例：
#   LLM_BASE_URL=https://api.deepseek.com/v1
#   LLM_MODEL=deepseek-chat
# 硅基流动（SiliconFlow）示例：
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=deepseek-ai/DeepSeek-V3   （多轮工具调用稳定，推荐）
#   LLM_MODEL=THUDM/GLM-4-9B-0414       （免费，但多轮会编造工具结果，不推荐做操作型 Agent）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# ---- 服务监听 ----
# 监听 0.0.0.0 时，手机连同一 WiFi 可通过电脑局域网 IP 访问
HOST=0.0.0.0
PORT=8000

# ---- 数据与保留策略 ----
DB_PATH=data/fitness.db
# Agent 对话历史保留天数，超期自动清理
CHAT_HISTORY_DAYS=3
