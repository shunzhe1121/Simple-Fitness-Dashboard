# 复制本文件为 .env 后填写。LLM 三项留空时，Agent 对话功能会提示未配置，
# 但模板粘贴解析、手动记录、统计图表等功能不受影响，可正常使用。

# ---- LLM 接入（OpenAI 兼容接口）----
# 小米 MiMo 示例（当前使用，与 VISION_* 共用同一 key）：
#   LLM_BASE_URL=https://api.xiaomimimo.com/v1
#   LLM_MODEL=mimo-v2.6-flash
# 其他 OpenAI 兼容平台示例（豆包 / 硅基流动）：
#   LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   LLM_MODEL=你的推理接入点 ID
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
#   LLM_MODEL=THUDM/GLM-4-9B-0414       （免费，但多轮会编造工具结果，不推荐做操作型 Agent）
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_TEMPERATURE=0.2

# ---- 视觉识图（拍照识餐）----
# 文本模型认不了图。想用「图片分析」录入饮食，需要单独配一个多模态模型；
# 三项留空时会逐项回落到上面的 LLM_*，那时识图必然失败（会明确提示是哪个模型不支持）。
# 小米 MiMo 示例（mimo-v2.6-flash 为全模态模型，key 为 sk- 开头）：
#   VISION_BASE_URL=https://api.xiaomimimo.com/v1
#   VISION_MODEL=mimo-v2.6-flash
# 硅基流动（SiliconFlow）示例：
#   VISION_BASE_URL=https://api.siliconflow.cn/v1
#   VISION_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# 未充值的 key 会返回 402 账户余额不足，链路本身是通的。
VISION_API_KEY=
VISION_BASE_URL=
VISION_MODEL=

# ---- 公网访问令牌 ----
# 留空时首次启动自动生成并写回本文件。
# 手机第一次用 地址/?k=令牌 打开一次，之后凭 cookie 免输。
# 填 off 可显式关闭校验，仅限纯本机调试——走隧道时不要关。
ACCESS_TOKEN=

# ---- 佳明同步 ----
# 留空则不做自动同步，其余功能不受影响
GARMIN_EMAIL=
GARMIN_PASSWORD=
# 同步起算日（YYYY-MM-DD）。每天自动同步会回看最近 7 天，
# 早于该日期的记录一律跳过——用于「清空历史、从某天重新开始」后防止旧日期被回填。
# 留空表示不限制。不需要时删掉这一行即可。
GARMIN_SINCE=

# ---- 服务监听 ----
# 监听 0.0.0.0 时，手机连同一 WiFi 可通过电脑局域网 IP 访问
HOST=0.0.0.0
PORT=8000

# ---- 数据与保留策略 ----
DB_PATH=data/fitness.db
# 拍照识餐的图片存放目录（按上传日期分子目录，压缩后的 JPEG）
MEALS_DIR=data/meals
# 单张图片上传上限（压缩前），超过直接拒绝，避免把磁盘塞满
MAX_IMAGE_MB=15
# Agent 对话历史保留天数，超期自动清理
CHAT_HISTORY_DAYS=3
