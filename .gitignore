# 环境变量（含 LLM API key，禁止提交）
.env

# 本地数据库（含真实健康数据，隐私）
data/

# 运行日志
server.log
*.log

# Python 缓存
__pycache__/
*.pyc
*.egg-info/
.venv/
venv/

# 个人 workspace 数据（记忆 / 草稿等）
.workbuddy/

# 个人启动脚本（含本地环境路径）
start.bat

# cloudflared 隧道二进制（53 MB，缺了会自动下载，不入库）
tools/

# 临时截图 / 验证脚本目录
.tmp-shots/

# 系统 / 编辑器
.DS_Store
Thumbs.db
.idea/
.vscode/

# Capacitor / Android 构建产物（源码保留，产物排除）
mobile/node_modules/
mobile/npm-cache/
mobile/android/.gradle/
mobile/android/build/
mobile/android/app/build/
mobile/android/capacitor-cordova-android-plugins/build/
mobile/android/app/src/main/assets/public/

# Release 签名密钥库（每个开发者/环境各自生成，不入库）
mobile/android/app/*.jks
mobile/android/app/*.keystore

# 注意：apk/ 目录是交付产物（现成安装包），需要纳入版本管理；
# 只排除 mobile/ 构建目录内的中间 APK（已由上面的 app/build 覆盖）。
